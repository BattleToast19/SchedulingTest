ini
# Copy this file to .env and fill in real values. NEVER commit .env.

# From developers.facebook.com -> your app -> Settings -> Basic
FB_APP_ID=
FB_APP_SECRET=

# Short-lived USER token from Graph API Explorer (only used by get_page_token.py)
FB_SHORT_LIVED_USER_TOKEN=

# Filled in after running get_page_token.py
FB_PAGE_ID=
FB_PAGE_TOKEN=

# Graph API version
FB_GRAPH_VERSION=v25.0
